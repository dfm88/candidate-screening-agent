# Copy to deploy.env (gitignored) and fill in. deploy.sh refuses to run if the active gcloud project differs.
# Format: plain KEY=value lines (no quotes, no `export`); variables already set in the environment win.
GCP_PROJECT=your-gcp-project-id
# Optional: a dedicated gcloud config directory, so the machine's default account is never used.
# CLOUDSDK_CONFIG=/path/to/gcloud-config-dir
# Optional overrides:
# REGION=europe-southwest1
# SERVICE=candidate-screening-agent
# SQL_INSTANCE=screening-pg
# LOGFIRE_TOKEN=...
# Key for the last fallback model (stored in Secret Manager). Without it the deploy has no fallback.
# OPENAI_API_KEY=...
