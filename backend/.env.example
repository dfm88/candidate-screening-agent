# Copy to .env (gitignored) and fill in what you need; every variable is optional unless noted.
# Load it into the process environment with `uv run --env-file .env …`: the app, the Logfire SDK and
# Google auth all read the environment, so one mechanism covers them all. Never put real values here.

# --- App ---
# Label on every trace and log, e.g. local or production. Default: local.
ENVIRONMENT=
# Postgres URL for asyncpg. Default matches compose: postgresql+asyncpg://screening:screening@localhost:55432/screening
DATABASE_URL=
# Send LLM prompts and completions (candidate PII) to Logfire: true/false. Default: false.
LLM_CONTENT_LOGGING=
# Directory of the built frontend, only when FastAPI serves it (the container sets this). Default: unset.
STATIC_DIR=

# --- Observability (optional) ---
# Logfire project write token. Without it, traces only go to the console.
LOGFIRE_TOKEN=

# --- Google Cloud / Vertex AI (optional: only for the Vertex EU models the deployed app uses) ---
# gcloud config directory used by gcloud and by Google application-default credentials.
CLOUDSDK_CONFIG=
# Project billed for Vertex AI calls.
GOOGLE_CLOUD_PROJECT=
