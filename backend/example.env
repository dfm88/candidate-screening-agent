# Copy to backend/.env (`cp example.env .env`, gitignored) and fill in what you need; empty means "use the default".
# Load it into the process environment with `uv run --env-file .env …`: the app, the Logfire SDK, the model
# providers and Google auth all read the environment, so one mechanism covers them all. Never put real values here.

# --- App ---
# Label on every trace and log, e.g. local or production. Default: local.
ENVIRONMENT=
# Postgres URL for asyncpg. Default matches compose: postgresql+asyncpg://screening:screening@localhost:55432/screening
DATABASE_URL=
# Directory of the built frontend, only when FastAPI serves it (the container sets this). Default: unset.
STATIC_DIR=
# Access code the public apply form requires; the reviewer link carries it as ?code=…. Default: unset (no check).
APPLY_ACCESS_CODE=
# Seconds a burst of candidate messages may take to settle before one turn answers them all. Default: 1.5.
CHAT_DEBOUNCE_SECONDS=

# --- Recruiter tool (/recruiter) ---
# The shared password of the recruiter login. Unset: the recruiter tool stays closed. A local-only value: the deploy
# takes its own from Secret Manager.
RECRUITER_PASSWORD=local-recruiter
# Signs the recruiter's session cookie; required with RECRUITER_PASSWORD. Generate one with `openssl rand -hex 32`.
SESSION_SECRET=local-only-session-secret
# The session cookie's Secure flag: false for local http. Default: true.
SESSION_HTTPS_ONLY=false

# --- Models ---
# PydanticAI model strings. google-cloud:… runs on Vertex AI (needs the Google Cloud section); openai:…, anthropic:…
# and google:… (Gemini API) use the provider's API key below.
# Model for live turns. Default: openai:gpt-5.6-terra (OpenAI's API; needs OPENAI_API_KEY).
# Processing in the EU: google-cloud:gemini-3.8-flash on Vertex AI (needs the Google Cloud section).
SCREENING_MODEL=
# Fallbacks tried in order when the model fails, as a JSON list; [] for none (then one key is enough).
# Default: ["google:gemini-3.8-flash"] (the Gemini API; needs GOOGLE_API_KEY).
SCREENING_FALLBACK_MODELS=
# Messages of past turns sent to the model, trimmed by whole turns. Default: 50.
MAX_HISTORY_MESSAGES=
# Seconds one request to one model may take, over every SDK retry; the next fallback gets a fresh deadline. Default: 10.
REQUEST_TIMEOUT=
# Seconds a whole turn may take before the candidate gets the "give me a moment" notice. Default: 35.
TURN_TIMEOUT=
# Model requests one turn may make. Default: 7.
TURN_REQUEST_LIMIT=
# Provider keys for openai:…, anthropic:… and google:… models (and the eval simulator and judge).
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Observability (optional) ---
# Logfire project write token. Without it, traces only go to the console.
LOGFIRE_TOKEN=
# Send LLM prompts and completions to Logfire: true/false. Default (in code): false, because real candidate data is
# PII. On here because local data is synthetic, so traces show the whole conversation.
LLM_CONTENT_LOGGING=true

# --- Google Cloud / Vertex AI (for google-cloud:… models) ---
# gcloud config directory used by gcloud and by Google application-default credentials.
CLOUDSDK_CONFIG=
# Project billed for Vertex AI calls.
GOOGLE_CLOUD_PROJECT=
# Vertex AI location. eu is the multi-region endpoint: processing stays in the EU.
GOOGLE_CLOUD_LOCATION=eu
